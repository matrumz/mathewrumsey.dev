# Sample .env file for this project
# To avoid collisions, prefix your variables with the project name or a unique identifier: MATHEWRUMSY_DEV_ in this case.
# For organizational purposes, this project follows the [.NET Environment Variable Naming Conventions](https://learn.microsoft.com/en-us/aspnet/core/fundamentals/configuration/#configuration-keys-and-values)

MATHEWRUMSEY_DEV_DOMAIN__ACME__EMAIL=email@example.com
MATHEWRUMSEY_DEV_DOMAIN__APEX=mathewrumsey.dev
MATHEWRUMSEY_DEV_HOST__NAME=homelab
MATHEWRUMSEY_DEV_HOST__PATHS__project=/workspaces/mathewrumsey.dev
MATHEWRUMSEY_DEV_HOST__TZ=America/New_York
MATHEWRUMSEY_DEV_HOST__USERS__default__GID=1000
MATHEWRUMSEY_DEV_HOST__USERS__default__UID=1000
MATHEWRUMSEY_DEV_HOST__USERS__docker__GID=999
