{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Touch Compose Override Files",
            "type": "shell",
            "command": "find . -type d \\( -name .container-data -o -name container-data \\) -prune -o -type f \\( -iname compose.yaml -o -iname compose.yml \\) -execdir touch compose.override.yaml \\;",
            "problemMatcher": []
        }
    ]
}
